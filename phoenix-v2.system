<?xml version="1.0" encoding="UTF-8"?>
<!--
  ASL-M30 — Phoenix v2.0 System Description
  AIEONYX Sovereign Layer · Apache 2.0
  Microkit SDK 1.4.1 · seL4 15.0.0
  16 Protection Domains: 7 sovereign core + 9 Phoenix desktop PDs
  PL-76: Full seL4 boot — GUI live under formally verified microkernel
  Sovereign proof: axon_main() → 0x4153
-->
<system>

  <!-- ══════════════════════════════════════════════════════
       SOVEREIGN MEMORY REGIONS
       QEMU virt AArch64 memory map
       ════════════════════════════════════════════════════ -->

  <memory_region name="fw_cfg"
                 size="0x1000"
                 phys_addr="0x09020000"/>  <!-- QEMU fw_cfg for ramfb -->
  <memory_region name="rtc"
                 size="0x1000"
                 phys_addr="0x09010000"/>  <!-- PL031 RTC -->
  <memory_region name="serial"
                 size="0x1000"
                 phys_addr="0x09000000"/>  <!-- PL011 UART -->

  <memory_region name="sovereign_proof_frame"
                 size="0x1000"
                 phys_addr="0x48000000"/>  <!-- axon_main() → 0x4153 -->

  <memory_region name="phoenix_heap"
                 size="0x400000"
                 phys_addr="0x4A000000"/>  <!-- 4MB sovereign heap -->

  <memory_region name="watchdog_registers"
                 size="0x1000"
                 phys_addr="0x4C000000"/>  <!-- SP805 Watchdog MMIO -->

  <!-- PL-76: GPU framebuffer — 1280×720 ARGB8888 = 3.6MB -->
  <memory_region name="gpu_dma"
                 size="0x20000"
                 phys_addr="0x4B000000"/>  <!-- virtio-gpu DMA queue (uncached) -->
  <memory_region name="gpu_framebuffer"
                 size="0x400000"
                 phys_addr="0x44000000"/>  <!-- ramfb device -->

  <!-- PL-76: virtio-gpu MMIO -->
  <memory_region name="virtio_mmio"
                 size="0x1000"
                 phys_addr="0x0a003000"/>  <!-- virtio MMIO: page-aligned, covers top slots -->

  <!-- ══════════════════════════════════════════════════════
       MANDATORY PDs — 7 sovereign core (M1-M7)
       ════════════════════════════════════════════════════ -->

  <protection_domain name="GENESIS"
                     priority="1"
                     budget="1000"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-genesis"/>
    <map mr="serial"               vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="sovereign_proof_frame" vaddr="0x48000000" perms="rw" cached="false"/>
  </protection_domain>

  <protection_domain name="ARPi-Broker"
                     priority="1"
                     budget="800"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-arpi-broker"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <protection_domain name="DataTier-Enforcer"
                     priority="1"
                     budget="600"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-datatier-enforcer"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <protection_domain name="TrustGraph-Gate"
                     priority="1"
                     budget="600"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-trustgraph-gate"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <protection_domain name="Inverted-Admin"
                     priority="1"
                     budget="500"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-inverted-admin-bin"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <protection_domain name="AXON-Bridge"
                     priority="1"
                     budget="800"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-axon-bridge-bin"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <protection_domain name="SOMA-Identity"
                     priority="1"
                     budget="400"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-soma-identity"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- ══════════════════════════════════════════════════════
       PHOENIX BOOT PDs — M15 (existing)
       ════════════════════════════════════════════════════ -->

  <protection_domain name="Phoenix-Init"
                     priority="1"
                     budget="1000"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-phoenix-init"/>
    <map mr="serial"       vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="phoenix_heap" vaddr="0x4A000000" perms="rw" cached="true"/>
  </protection_domain>

  <protection_domain name="Phoenix-Console"
                     priority="1"
                     budget="500"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-phoenix-console"/>
    <map mr="serial"       vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="phoenix_heap" vaddr="0x4A000000" perms="r"  cached="true"/>
  </protection_domain>

  <protection_domain name="Phoenix-Watchdog"
                     priority="1"
                     budget="200"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-phoenix-watchdog"/>
    <map mr="serial"             vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="watchdog_registers" vaddr="0x4C000000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- ══════════════════════════════════════════════════════
       PL-76: PHOENIX DESKTOP PDs — M25-M29
       ════════════════════════════════════════════════════ -->

  <!-- GPU-Cap PD: sole FramebufferWrite holder -->
  <protection_domain name="HANIEL-Canvas"
                     priority="1"
                     budget="800"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-haniel-canvas-pd-bin"/>
    <map mr="serial"          vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="gpu_framebuffer" vaddr="0x44000000" perms="rw" cached="false"/>
    <map mr="virtio_mmio"      vaddr="0x0a003000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- Phoenix-Desktop PD: render loop via HANIEL -->
  <protection_domain name="Phoenix-Desktop"
                     priority="254"
                     budget="20000"
                     period="20000">
    <program_image path="/home/edisonbl/aixos/target/aarch64-unknown-none/microkit/aixos-phoenix-pd"/>
    <map mr="rtc"            vaddr="0x09010000" perms="rw" cached="false"/>
    <map mr="serial"         vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="fw_cfg"          vaddr="0x09020000" perms="rw" cached="false"/>
    <map mr="phoenix_heap"   vaddr="0x4A000000" perms="rw" cached="true"/>
    <map mr="virtio_mmio"    vaddr="0x0a003000" perms="rw" cached="false"/>
    <map mr="gpu_framebuffer" vaddr="0x44000000" perms="rw" cached="true"/>
    <map mr="gpu_dma"         vaddr="0x4B000000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- Shell-PD: axc> shell isolated -->
  <protection_domain name="Shell-PD"
                     priority="1"
                     budget="600"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-shell-pd-bin"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- EdisonDB-PD: sovereign store isolated -->
  <protection_domain name="EdisonDB-PD"
                     priority="1"
                     budget="600"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-edisondb-pd-bin"/>
    <map mr="serial"       vaddr="0x09000000" perms="rw" cached="false"/>
    <map mr="phoenix_heap" vaddr="0x4A000000" perms="rw" cached="true"/>
  </protection_domain>

  <!-- Onyxia-PD: sovereign browser, http:// blocked -->
  <protection_domain name="Onyxia-PD"
                     priority="1"
                     budget="600"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-onyxia-pd-bin"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- AXON-Exec-PD: scripts in isolated PD -->
  <protection_domain name="AXON-Exec-PD"
                     priority="1"
                     budget="400"
                     period="1000">
    <program_image path="target/aarch64-unknown-none/release/asl-axon-exec-pd-bin"/>
    <map mr="serial" vaddr="0x09000000" perms="rw" cached="false"/>
  </protection_domain>

  <!-- ══════════════════════════════════════════════════════
       IPC CHANNELS — existing M15 + PL-76 new channels
       ════════════════════════════════════════════════════ -->

  <!-- Existing M15 channels -->
  <channel>
    <end pd="GENESIS" id="0"/>
    <end pd="Phoenix-Init" id="0"/>
  </channel>

  <channel>
    <end pd="Phoenix-Init" id="1"/>
    <end pd="ARPi-Broker" id="0"/>
  </channel>

  <channel>
    <end pd="Phoenix-Init" id="2"/>
    <end pd="SOMA-Identity" id="1"/>
  </channel>

  <channel>
    <end pd="Phoenix-Init" id="3"/>
    <end pd="Phoenix-Console" id="0"/>
  </channel>

  <channel>
    <end pd="Phoenix-Init" id="4"/>
    <end pd="Phoenix-Watchdog" id="0"/>
  </channel>

  <channel>
    <end pd="Phoenix-Watchdog" id="1"/>
    <end pd="GENESIS" id="1"/>
  </channel>

  <channel>
    <end pd="ARPi-Broker" id="1"/>
    <end pd="DataTier-Enforcer" id="0"/>
  </channel>

  <channel>
    <end pd="DataTier-Enforcer" id="1"/>
    <end pd="TrustGraph-Gate" id="0"/>
  </channel>

  <channel>
    <end pd="TrustGraph-Gate" id="1"/>
    <end pd="Inverted-Admin" id="0"/>
  </channel>

  <channel>
    <end pd="Inverted-Admin" id="1"/>
    <end pd="AXON-Bridge" id="0"/>
  </channel>

  <!-- PL-76: Phoenix desktop IPC channels -->
  <!-- Phoenix-Init → Phoenix-Desktop: boot signal -->
  <channel>
    <end pd="Phoenix-Init" id="5"/>
    <end pd="Phoenix-Desktop" id="0"/>
  </channel>

  <!-- Phoenix-Init → HANIEL-Canvas: GPU-Cap grant -->
  <channel>
    <end pd="Phoenix-Init" id="6"/>
    <end pd="HANIEL-Canvas" id="0"/>
  </channel>

  <!-- Phoenix-Desktop → HANIEL-Canvas: render requests -->
  <channel>
    <end pd="Phoenix-Desktop" id="1"/>
    <end pd="HANIEL-Canvas" id="1"/>
  </channel>

  <!-- Onyxia-PD → HANIEL-Canvas: awp:// page render -->
  <channel>
    <end pd="Onyxia-PD" id="0"/>
    <end pd="HANIEL-Canvas" id="2"/>
  </channel>

  <!-- Shell-PD → ARPi-Broker: all shell IPC via ARPi -->
  <channel>
    <end pd="Shell-PD" id="0"/>
    <end pd="ARPi-Broker" id="2"/>
  </channel>

  <!-- Shell-PD → AXON-Exec-PD: script execution -->
  <channel>
    <end pd="Shell-PD" id="1"/>
    <end pd="AXON-Exec-PD" id="0"/>
  </channel>

  <!-- EdisonDB-PD → DataTier-Enforcer: tier enforcement -->
  <channel>
    <end pd="EdisonDB-PD" id="0"/>
    <end pd="DataTier-Enforcer" id="2"/>
  </channel>

  <!-- Phoenix-Desktop → EdisonDB-PD: status queries -->
  <channel>
    <end pd="Phoenix-Desktop" id="2"/>
    <end pd="EdisonDB-PD" id="1"/>
  </channel>

  <!-- Phoenix-Desktop → Shell-PD: shell output rendering -->
  <channel>
    <end pd="Phoenix-Desktop" id="3"/>
    <end pd="Shell-PD" id="2"/>
  </channel>

</system>
