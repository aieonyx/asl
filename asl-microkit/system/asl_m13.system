<?xml version="1.0" encoding="UTF-8"?>
<!--
    ASL-M13 Microkit System Description — Onyxia Browser PD
    Copyright (c) 2026 Edison Lepiten / AIEONYX
    SPDX-License-Identifier: Apache-2.0

    Ten PDs: + Onyxia Browser
    Priority 160 — between EdisonDB and Storage
    MCS: budget=500us period=1000us (browser is latency-sensitive)

    Channel topology additions:
      HANIEL(2)     ↔ Onyxia(1) — display surface
      Network(3)    ↔ Onyxia(2) — network/AWP routing
      EdisonDB(3)   ↔ Onyxia(3) — session persistence
-->
<system>
    <protection_domain name="genesis" priority="254"
        budget="1000" period="1000">
        <program_image path="asl-genesis-pd.elf" />
    </protection_domain>

    <protection_domain name="axon_bridge" priority="220"
        budget="600" period="1000">
        <program_image path="asl-axon-bridge-pd.elf" />
    </protection_domain>

    <protection_domain name="arpi_broker" priority="200"
        budget="500" period="1000">
        <program_image path="asl-arpi-pd.elf" />
    </protection_domain>

    <protection_domain name="haniel_engine" priority="190"
        budget="800" period="1000">
        <program_image path="asl-haniel-pd.elf" />
    </protection_domain>

    <protection_domain name="network_drv" priority="180"
        budget="400" period="1000">
        <program_image path="asl-network-pd.elf" />
    </protection_domain>

    <protection_domain name="edisondb" priority="170"
        budget="400" period="1000">
        <program_image path="asl-edisondb-pd.elf" />
    </protection_domain>

    <protection_domain name="onyxia" priority="160"
        budget="500" period="1000">
        <program_image path="asl-onyxia-pd.elf" />
    </protection_domain>

    <protection_domain name="storage_drv" priority="150"
        budget="300" period="1000">
        <program_image path="asl-storage-pd.elf" />
    </protection_domain>

    <protection_domain name="usb_drv" priority="120"
        budget="200" period="1000">
        <program_image path="asl-usb-pd.elf" />
    </protection_domain>

    <protection_domain name="input_drv" priority="100"
        budget="200" period="1000">
        <program_image path="asl-input-pd.elf" />
    </protection_domain>

    <channel>
        <end pd="genesis" id="1" />
        <end pd="arpi_broker" id="1" />
    </channel>

    <channel>
        <end pd="genesis" id="2" />
        <end pd="usb_drv" id="1" />
    </channel>

    <channel>
        <end pd="arpi_broker" id="2" />
        <end pd="edisondb" id="2" />
    </channel>

    <channel>
        <end pd="arpi_broker" id="3" />
        <end pd="network_drv" id="1" />
    </channel>

    <channel>
        <end pd="usb_drv" id="2" />
        <end pd="network_drv" id="2" />
    </channel>

    <channel>
        <end pd="arpi_broker" id="4" />
        <end pd="axon_bridge" id="1" />
    </channel>

    <channel>
        <end pd="arpi_broker" id="5" />
        <end pd="haniel_engine" id="1" />
    </channel>

    <channel>
        <end pd="edisondb" id="1" />
        <end pd="storage_drv" id="1" />
    </channel>

    <channel>
        <end pd="haniel_engine" id="2" />
        <end pd="onyxia" id="1" />
    </channel>

    <channel>
        <end pd="network_drv" id="3" />
        <end pd="onyxia" id="2" />
    </channel>
</system>
